# Penny's starter tables (YUI-170). Bills are the usual ones with amounts left for you; Due is the day of the month.
table create tasks Task:text Due:date Priority:text Done:bool
put tasks t1 Task="Tell Penny what's on your mind this week" Priority=High
table create errands Errand:text Where:text Done:bool
put errands e1 Errand="Pick up a prescription" Where=Pharmacy
put errands e2 Errand="Drop off returns" Where="Post office"
table create bills Bill:text Amount:number:$ Due:number Autopay:bool Paid:bool
put bills rent Bill=Rent Due=1
put bills phone Bill=Phone Due=15
put bills internet Bill=Internet Due=20
put bills electric Bill=Electric Due=25
put bills streaming Bill=Streaming Due=5
