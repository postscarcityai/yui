# The day's goal: the Today board reads it. Basil changes it when they set a goal.
table create goal Cal:number:kcal Protein:number:g Carbs:number:g Fat:number:g
put goal daily Cal=2100 Protein=140 Carbs=210 Fat=70
# The week Plan my meals made (one row a meal), and what they asked for last time.
table create meal_plan Day:date Slot:text Recipe:text Name:text Cal:number:kcal Protein:number:g Carbs:number:g Fat:number:g Minutes:number
table create plan_prefs Days:number Meals:text Likes:text Avoid:text Budget:text Cook:text
# The grocery list, by aisle: the plan fills it (From=plan), they add to it (From=you), a tick sets Got.
table create groceries Item:text Qty:text Aisle:text Got:bool From:text
put groceries greek-yogurt Item="Greek yogurt" Aisle="Dairy and eggs" From=you
put groceries egg Item=Eggs Aisle="Dairy and eggs" From=you
put groceries spinach Item=Spinach Aisle=Produce From=you
put groceries chicken-thigh Item="Chicken thighs" Aisle="Meat and fish" From=you
put groceries rice Item=Rice Aisle=Pantry From=you
put groceries berry Item=Berries Aisle=Produce From=you
