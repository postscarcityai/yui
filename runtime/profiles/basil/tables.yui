# Basil's starter tables (YUI-170). Foods: common foods, one usual portion each, rounded from USDA FoodData Central.
# Meals starts empty; it is the log (YUI-103's food memory builds on Foods). The rest are his tools (YUI-183, src/mealplan.ts).
table create foods Food:text Portion:text Cal:number:kcal Protein:number:g Carbs:number:g Fat:number:g
put foods egg Food=Egg Portion="1 large" Cal=72 Protein=6.3 Carbs=0.4 Fat=4.8
put foods egg-white Food="Egg white" Portion="1 large" Cal=17 Protein=3.6 Carbs=0.2 Fat=0.1
put foods chicken-breast Food="Chicken breast, cooked" Portion="100 g" Cal=165 Protein=31 Carbs=0 Fat=3.6
put foods salmon Food="Salmon, cooked" Portion="100 g" Cal=206 Protein=22 Carbs=0 Fat=12
