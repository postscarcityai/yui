      "parameters": {
        "jsCode": "// One POST per turn from the Yui webhook bridge (spec/WEBHOOK.md).\n// A tap arrives as a message with kind \"event\" and its JSON in `event`.\nconst turn = $input.first().json.body;\nconst tap = (turn.messages || []).filter((m) => m.kind === 'event' && m.event).pop();\nif (tap) {\n  const picked = tap.event.echo ?? tap.event.value?.choice;\n  return [{ json: { reply: `${picked} it is. n8n got your tap.` } }];\n}\nreturn [{ json: { reply: \"Hi from n8n! What's for lunch?\\n```yui\\nchoose \\\"Lunch?\\\" Salad|Soup|Tacos\\n```\" } }];\n"
      }
    },
    {
      "id": "9a3f5b20-0003-4b8c-9e11-3c7d2a4f0003",
      "name": "Reply",
